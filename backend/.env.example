# Copy this file to `.env` and fill in whatever keys you have.
#
# Keys are optional. Without keys, text and text-based PDFs use local retrieval
# and extractive answers. Remote providers receive retrieved content, so choose
# one explicitly if you want generated answers and/or multimodal extraction.

# Which provider answers chat questions: auto | pollinations | openrouter | groq | gemini
# "auto" = first provider that has a key, else the keyless Pollinations endpoint.
# Set LLM_PROVIDER=local to keep every answer on this machine.
LLM_PROVIDER=auto

# --- Optional remote provider (no API key, but sends context remotely) --------
# Set LLM_PROVIDER=pollinations to opt in.
POLLINATIONS_BASE_URL=https://text.pollinations.ai/openai
POLLINATIONS_MODEL=openai

# --- OpenRouter (free `:free` models, also unlocks image understanding) -------
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Groq (free tier; also unlocks Whisper audio transcription) --------------
# Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# --- Google Gemini (optional; the only provider that reads video + scanned
# --- PDFs, and the only one giving true semantic embeddings) ------------------
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash
MEDIA_MODEL=gemini-2.5-flash
EMBED_DIM=768
TOP_K=6
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=200
