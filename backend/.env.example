# Copy this file to `.env` and fill in your key.
#
# Google AI Studio key (free tier available): https://aistudio.google.com/apikey
# Without a key the app still runs, but in "local" mode: text/PDF search works
# with lightweight local embeddings and media files are indexed by their note
# and filename only (no vision / audio / video understanding).
GEMINI_API_KEY=

# Optional overrides
EMBED_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-2.5-flash
MEDIA_MODEL=gemini-2.5-flash
EMBED_DIM=768
TOP_K=6
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
MAX_UPLOAD_MB=200
